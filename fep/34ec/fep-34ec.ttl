# FEP-34ec: Notification Collection Endpoint
#
# RDFS/OWL ontology for the FEP-34ec vocabulary terms.
# This is a reference artefact — NOT loaded at runtime.
# It documents the property defined by FEP-34ec.
#
# See: https://w3id.org/fep/34ec

@prefix fep34ec: <https://w3id.org/fep/34ec#> .
@prefix as:      <https://www.w3.org/ns/activitystreams#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .

# ── Ontology metadata ────────────────────────────────────────────────

<https://w3id.org/fep/34ec#>
  a owl:Ontology ;
  rdfs:label "FEP-34ec Notification Collection Vocabulary" ;
  rdfs:comment "Defines the notifications endpoint property for ActivityPub actors." .

# ── Properties ───────────────────────────────────────────────────────

fep34ec:notifications
  a owl:ObjectProperty ;
  rdfs:label "notifications" ;
  rdfs:comment "The notification collection endpoint for an actor. Used under endpoints in the actor object." ;
  rdfs:range as:OrderedCollection .
